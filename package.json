{
  "name": "worktree-console",
  "version": "0.1.0",
  "description": "Local-first console for registered Git projects, worktrees, branches, and local services.",
  "type": "module",
  "bin": {
    "worktree-console": "bin/worktree-console.js"
  },
  "files": [
    "bin/",
    "dist/",
    "src/cli.ts",
    "src/server/",
    "src/shared/",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duanduanc00-commits/worktree-console.git"
  },
  "bugs": {
    "url": "https://github.com/duanduanc00-commits/worktree-console/issues"
  },
  "homepage": "https://github.com/duanduanc00-commits/worktree-console#readme",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "start": "node bin/worktree-console.js",
    "build": "tsc --noEmit && vite build",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "^5.1.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "supertest": "^7.0.0",
    "tailwind-merge": "^2.5.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
